# Cumora self-hosting configuration.
#
#   cp .env.example .env    # then fill in the values below
#   docker compose up -d
#   open http://localhost:5181
#
# Only OPENAI_API_KEY and AGENT_RUNTIME_SECRET are strictly required; the rest
# have working defaults.

# ─── Image ─────────────────────────────────────────────────────────────────
# Pin a commit SHA or version tag for reproducible upgrades. `latest` follows
# upstream main and will silently change under you.
CUMORA_IMAGE=ghcr.io/dockers-x/cumora:latest

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=cumora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cumora

# ─── Required ──────────────────────────────────────────────────────────────
# Used for agent chat turns, classifiers and image generation.
OPENAI_API_KEY=sk-...

# Signs the per-agent runtime JWTs. The image boots with NODE_ENV=production,
# which refuses to start while this is left at the public dev default.
# Generate with: openssl rand -hex 32
AGENT_RUNTIME_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────
# Public origin of this deployment. OpenAI fetches attachment URLs from its
# own network, so image attachments only work when this is reachable from the
# internet (e.g. an ngrok/cloudflared tunnel).
PUBLIC_HOST=http://localhost:5181

# Model pins. Leave blank for the defaults baked into the image.
# OPENAI_MODEL=gpt-5.5
# OPENAI_MODEL_SUPPORT=gpt-5.4-mini

# Object storage. Without all four of these the server keeps attachments on
# the local volume (fine for a single-host install).
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Additional browser origins allowed to call the API. Comma-separated;
# `*` allows any origin.
# CUMORA_CORS_ORIGINS=
